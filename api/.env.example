PORT=4000

# Required in production. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# SQLite database file (":memory:" for an in-memory DB)
DB_FILE=data/b2b.sqlite

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# true  -> new registrations can sign in immediately
# false -> new registrations stay "pending" until an admin activates them
AUTO_APPROVE_BUYERS=true
